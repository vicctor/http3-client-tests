{
  "name": "http3-early-hints-server",
  "version": "1.0.0",
  "description": "Node.js server implementing HTTP Early Hints (103 status code)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test-server.js",
    "generate-certs": "node generate-certs.js",
    "demo": "node server.js --demo",
    "http3": "node http3-server.js",
    "universal": "node universal-http3-server.js",
    "http3-ready": "node http3-ready-server.js",
    "start-http3": "node http3-ready-server.js",
    "compare": "echo 'Starting HTTP/2 server on 3444 and HTTP/3 on 3443...' && node universal-http3-server.js"
  },
  "keywords": [
    "http",
    "http2",
    "early-hints",
    "103",
    "performance",
    "nodejs",
    "server"
  ],
  "author": "HTTP Early Hints Demo",
  "license": "MIT",
  "dependencies": {
    "@http3-server/native": "^0.1.0",
    "colors": "^1.4.0",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "mime-types": "^2.1.35",
    "node-fetch": "^3.3.2",
    "quico": "^0.1.3",
    "selfsigned": "^2.4.1",
    "spdy": "^4.0.2",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
